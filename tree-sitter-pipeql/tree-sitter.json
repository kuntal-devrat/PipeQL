{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "pipeql",
      "camelcase": "PipeQL",
      "scope": "source.pipeql",
      "path": ".",
      "file-types": [
        "pql",
        "pipeql"
      ],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "1.1.7",
    "license": "MIT",
    "description": "Tree-sitter grammar for PipeQL - pipelined & injection-safe polyglot query language",
    "authors": [
      {
        "name": "PipeQL"
      }
    ]
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
  }
}