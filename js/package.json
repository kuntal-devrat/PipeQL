{
  "name": "@flaxmbot/pipeql",
  "version": "1.1.7",
  "description": "JavaScript/TypeScript SDK for PipeQL - pipelined & injection-safe polyglot query language",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./driver": {
      "types": "./src/driver.d.ts",
      "import": "./src/driver.js"
    },
    "./builder": {
      "types": "./src/builder.d.ts",
      "import": "./src/builder.js"
    }
  },
  "files": [
    "src/**/*",
    "dist/**/*",
    "ai/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node test/smoke.mjs && node test/builder-smoke.mjs && node test/driver-smoke.mjs"
  },
  "keywords": [
    "sql",
    "query",
    "postgres",
    "sqlite",
    "duckdb",
    "mysql",
    "compiler",
    "pipeql"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}